<!-- omikuji_app/app/views/fortunes/_show.html.erb -->
<% fortune ||= @fortune %>

<%= turbo_stream_from fortune %>
<div id="fortune_<%= fortune.id %>" class="max-w-md mx-auto my-8 md:my-12 bg-white shadow-[0_40px_100px_-20px_rgba(0,0,0,0.15)] rounded-2xl p-6 md:p-10 font-serif relative overflow-hidden animate-slide-up border border-stone-100">
  <!-- Subtle Header -->
  <div class="flex justify-between items-start mb-8 md:mb-12 border-b border-stone-100 pb-6 md:pb-8">
    <div class="text-left">
      <h2 class="text-xl md:text-2xl font-black text-red-800 tracking-[0.3em]">御神籤</h2>
      <p class="text-[9px] text-stone-400 font-bold uppercase tracking-[0.2em] mt-1">Divine Echo #<%= format('%04d', fortune.id) %></p>
    </div>
    <div class="text-right">
       <span class="text-[9px] font-black text-stone-300 uppercase tracking-widest">Local Inference</span>
       <div class="h-0.5 w-8 bg-red-800 ml-auto mt-1"></div>
    </div>
  </div>

  <!-- Rank (The Big Blessing) or Loading -->
  <div class="text-center mb-10 md:mb-16 relative py-8 md:py-12 bg-stone-50/50 rounded-xl border border-white">
    <% if fortune.status == "pending" %>
      <div class="flex flex-col items-center justify-center space-y-6 py-4">
        <div class="text-5xl md:text-7xl animate-float">⛩️</div>
        <div class="flex flex-col items-center">
          <div class="w-12 h-1 bg-red-800 animate-pulse mb-4"></div>
          <p class="text-stone-800 font-serif text-lg md:text-xl tracking-widest uppercase font-black">神託を待つ...</p>
          <p class="text-stone-400 text-[10px] mt-2 italic tracking-widest">Awaiting the Divine Oracle</p>
        </div>
      </div>
    <% else %>
      <span class="text-6xl md:text-8xl font-black text-red-700 tracking-tighter drop-shadow-xl block">
        <%= fortune.rank.split(' ').first %>
      </span>
      <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-white px-4 py-1 rounded-full border border-stone-100 shadow-sm">
        <p class="text-[9px] md:text-[10px] text-stone-500 font-black tracking-[0.3em] uppercase whitespace-nowrap">
          <%= fortune.rank.split(' ').last %>
        </p>
      </div>
    <% end %>
  </div>

  <!-- Sentiment Analysis Detail -->
  <% if fortune.status != "pending" %>
    <div class="mb-10 md:mb-16">
      <div class="flex items-center space-x-3 mb-4">
        <div class="w-2 h-2 rounded-full <%= case fortune.sentiment_label; when 'positive'; 'bg-green-500'; when 'neutral'; 'bg-stone-400'; else; 'bg-amber-500'; end %>"></div>
        <h3 class="text-[10px] font-black text-stone-400 uppercase tracking-widest"><%= fortune.sentiment_label %> Sentiment Detected</h3>
      </div>
      <p class="text-xl md:text-2xl text-stone-800 leading-tight italic font-medium mb-6 break-words">"<%= fortune.input_text %>"</p>
      <div class="flex items-center space-x-3">
        <div class="h-1 flex-grow bg-stone-100 rounded-full overflow-hidden">
          <div class="h-full <%= case fortune.sentiment_label; when 'positive'; 'bg-green-600'; when 'neutral'; 'bg-stone-500'; else; 'bg-amber-600'; end %> transition-all duration-1000" 
               style="width: <%= [(fortune.score.abs * 100).to_i, 100].min %>%"></div>
        </div>
        <span class="text-[10px] font-black text-stone-500 tracking-tighter">
          <%= (fortune.score.abs * 100).round(1) %>%
        </span>
      </div>
    </div>
  <% else %>
    <div class="mb-10 md:mb-16 opacity-50">
      <h3 class="text-[10px] font-black text-stone-400 uppercase tracking-widest mb-4">Analyzing Spiritual Echo...</h3>
      <p class="text-xl md:text-2xl text-stone-400 leading-tight italic font-medium mb-6 break-words">"<%= fortune.input_text %>"</p>
    </div>
  <% end %>

  <!-- The Fortune Text (GPT-2 Output) -->
  <% if fortune.status != "pending" %>
    <div class="mb-10 md:mb-16 text-center px-2 md:px-6 relative">
      <div class="w-12 h-[1px] bg-stone-200 mx-auto mb-6 md:mb-8"></div>
      <p class="text-2xl md:text-3xl leading-[1.4] text-stone-900 font-medium tracking-tight break-words">
        <%= fortune.fortune_text.gsub(/[「」]/, '') %>
      </p>
      <div class="w-12 h-[1px] bg-stone-200 mx-auto mt-6 md:mt-8"></div>
    </div>
  <% end %>

  <!-- Action Footer -->
  <div class="grid grid-cols-2 gap-2 md:gap-4 pt-8 md:pt-10 border-t border-stone-100">
    <div data-controller="share" data-share-url-value="<%= fortune_url(fortune) %>">
      <button data-action="click->share#copy" class="w-full flex flex-col items-center group cursor-pointer">
        <div class="p-2 md:p-3 rounded-full bg-stone-50 group-hover:bg-red-50 transition-colors mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-stone-400 group-hover:text-red-700 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <span data-share-target="label" class="text-[8px] md:text-[9px] font-black uppercase tracking-widest text-stone-500 group-hover:text-red-800 transition-center text-center">Copy Link</span>
      </button>
    </div>

    <%= link_to root_path, class: "w-full flex flex-col items-center group no-underline" do %>
      <div class="p-2 md:p-3 rounded-full bg-stone-50 group-hover:bg-red-50 transition-colors mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-stone-400 group-hover:text-red-700 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
      </div>
      <span class="text-[8px] md:text-[9px] font-black uppercase tracking-widest text-stone-500 group-hover:text-red-800 transition-center text-center">Return Home</span>
    <% end %>
  </div>

  <!-- Subtle Watermark -->
  <div class="absolute -top-10 -right-10 opacity-[0.03] pointer-events-none transform rotate-12">
    <span class="text-[12rem] font-black">福</span>
  </div>
</div>
