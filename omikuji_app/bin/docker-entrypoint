#!/bin/bash -e

# Detect if we are running the rails server (potentially via thrust), background worker, or the monolith script
if [[ "$*" == *"bin/rails server"* ]] || [[ "$*" == *"bin/jobs"* ]] || [[ "$*" == *"bin/start-monolith"* ]]; then
  if [[ -z "${SKIP_DB_PREPARE}" ]]; then
    echo "[Entrypoint] Preparing database..."
    ./bin/rails db:prepare
  fi
fi

exec "${@}"
